<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DCMTK Native vs dcm4che3 对比测试"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- 文件选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/sp_files"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新" />
        </LinearLayout>

        <!-- 1. loadDicomFileInfoEx -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="① loadDicomFileInfoEx（命名 key）"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_load_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运行" />

        <TextView
            android:id="@+id/tv_load_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#11000000"
            android:padding="6dp"
            android:text="（等待运行）" />

        <!-- 2. readDicomWindowSettings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="② readDicomWindowSettings"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_window_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运行" />

        <TextView
            android:id="@+id/tv_window_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#11000000"
            android:padding="6dp"
            android:text="（等待运行）" />

        <!-- 3. dicomFile2Bitmap -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="③ dicomFile2Bitmap"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_bitmap_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认窗" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WW:" />

            <EditText
                android:id="@+id/et_ww"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:text="2000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WC:" />

            <EditText
                android:id="@+id/et_wc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:text="1000" />

            <Button
                android:id="@+id/btn_bitmap_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义窗" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_bitmap_default"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#22000000" />

        <ImageView
            android:id="@+id/iv_bitmap_custom"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#22000000" />

        <!-- 4. writeDcmFile -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="④ writeDcmFile（合成 raw → 写 dcm → 回读验证）"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="窗位窗宽算法:" />

            <Spinner
                android:id="@+id/sp_win_method"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_write_dcm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行 round-trip" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_write_dcm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#11000000"
            android:padding="6dp"
            android:text="（等待运行）" />

        <ImageView
            android:id="@+id/iv_write_dcm"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#22000000" />

        <!-- 对比说明 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⑤ 两者对比说明（dcm4che3 vs DCMTK native）"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_compare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#11000000"
            android:padding="6dp" />

    </LinearLayout>
</ScrollView>
