<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="CT Preprocess (Medical CT)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1) Data Source -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Asset Source"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_data610"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Data610" />

            <RadioButton
                android:id="@+id/rb_data622"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data622" />
        </RadioGroup>

        <!-- 2) Base Parameters -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2) Base Parameters (Geometry &amp; HU)"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W:" />

            <EditText
                android:id="@+id/et_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:text="1112"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H:" />

            <EditText
                android:id="@+id/et_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"

                android:text="1740"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bit:" />

            <RadioGroup
                android:id="@+id/rg_bit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_8bit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8" />

                <RadioButton
                    android:id="@+id/rb_16bit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="16" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slope:" />

            <EditText
                android:id="@+id/et_slope"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:text="1.0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intercept:" />

            <EditText
                android:id="@+id/et_intercept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberSigned|numberDecimal"
                android:text="-1024.0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3) Operations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3) Preprocess Operations"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:padding="2dp"
            android:rowOrderPreserved="false">

            <!-- Row 1, Col 1 -->
            <CheckBox
                android:id="@+id/cb_hu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="HU校正"
                android:textSize="12sp" />

            <!-- Row 1, Col 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_gaussian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高斯去噪"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K:"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_gauss_k"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="5"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 1, Col 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_median"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中值去噪"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K:"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_median_k"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="3"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 2, Col 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_bilateral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双边去噪"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="d:"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_bilateral_d"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="5"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 2, Col 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_fft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="频域FFT"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R:"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_fft_r"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="300"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 2, Col 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_resample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重采样"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_res_w"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="1112"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/et_res_h"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:text="1740"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Row 3, Col 1 -->
            <CheckBox
                android:id="@+id/cb_equalize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="直方图均衡"
                android:textSize="12sp" />

            <!-- Row 3, Col 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_clahe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLAHE增强"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_clahe_clip"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:text="2.0"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 3, Col 3 -->
            <CheckBox
                android:id="@+id/cb_stretch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="对比度拉伸"
                android:textSize="12sp" />

            <!-- Row 4, Col 1 -->
            <CheckBox
                android:id="@+id/cb_tailor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="图片裁剪"
                android:textSize="12sp" />
        </GridLayout>

        <!-- 4) Execution -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_run"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOAD &amp; DISPLAY" />

                <Button
                    android:id="@+id/btn_full_pipeline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="标准流水线" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_tailor_pipeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="图片裁剪后，的标准流程" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:text="(status info)"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="#11000000"
            android:contentDescription="result image"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EEE"
            android:padding="8dp"
            android:text="Summary will appear after run."
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
