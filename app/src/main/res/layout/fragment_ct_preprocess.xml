<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="CT Preprocess (Optimal Adjustment Only)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1) Data Source -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Asset Source"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- 2) Base Parameters -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2) Base Parameters"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W:" />

            <EditText
                android:id="@+id/et_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="1112"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H:" />

            <EditText
                android:id="@+id/et_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="number"
                android:text="1740"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_bit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_8bit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" />
                <RadioButton android:id="@+id/rb_16bit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="16" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rg_endian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_big_endian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Big" />
                <RadioButton android:id="@+id/rb_little_endian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Little" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slope:" />
            <EditText android:id="@+id/et_slope" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberDecimal" android:text="1.0" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intercept:" />
            <EditText android:id="@+id/et_intercept" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inputType="numberSigned|numberDecimal" android:text="-1024.0" android:textSize="13sp" />
        </LinearLayout>

        <!-- 3) Operations Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3) Preprocess Pipeline Status"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">
            <CheckBox android:id="@+id/cb_hu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HU校正" android:enabled="false" />
            <CheckBox android:id="@+id/cb_tailor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="图片裁剪" android:enabled="false" />
            <CheckBox android:id="@+id/cb_invert" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Invert LUTs" android:enabled="false" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <CheckBox android:id="@+id/cb_bilateral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="双边去噪" android:enabled="false" />
                <EditText android:id="@+id/et_bilateral_d" android:layout_width="30dp" android:layout_height="wrap_content" android:text="5" android:textSize="11sp" android:enabled="false" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <CheckBox android:id="@+id/cb_clahe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLAHE" android:enabled="false" />
                <EditText android:id="@+id/et_clahe_clip" android:layout_width="30dp" android:layout_height="wrap_content" android:text="3.0" android:textSize="11sp" android:enabled="false" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <CheckBox android:id="@+id/cb_sharpen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="特征锐化" android:enabled="false" />
                <EditText android:id="@+id/et_sharpen_strength" android:layout_width="30dp" android:layout_height="wrap_content" android:text="6.0" android:textSize="11sp" android:enabled="false" />
            </LinearLayout>

            <!-- Hidden radio for method mapping in code -->
            <RadioButton android:id="@+id/rb_win_peak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Peak Area" android:visibility="gone" />
        </GridLayout>

        <Button
            android:id="@+id/btn_optimal_adjustment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="执行最优调节" />

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:text="(status info)"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <com.example.dcmtkdemo.view.ZoomImageView android:id="@+id/iv_before" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#10000000" android:scaleType="matrix" />
            <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#44000000" />
            <com.example.dcmtkdemo.view.ZoomImageView android:id="@+id/iv_after" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#10000000" android:scaleType="matrix" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EEE"
            android:padding="8dp"
            android:text="Summary will appear after run."
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
