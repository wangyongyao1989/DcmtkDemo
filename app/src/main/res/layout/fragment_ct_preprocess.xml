<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CT Preprocess (Medical CT)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <!-- 1) Data Source -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Asset Source"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/rg_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rb_data610" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data610.bin" android:checked="true"/>
            <RadioButton android:id="@+id/rb_data622" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Data622.bin"/>
        </RadioGroup>

        <!-- 2) Base Parameters -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2) Base Parameters (Geometry &amp; HU)"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W:"/>
            <EditText android:id="@+id/et_width" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1112" android:inputType="number" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H:"/>
            <EditText android:id="@+id/et_height" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1740" android:inputType="number" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bit:"/>
            <RadioGroup android:id="@+id/rg_bit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rb_8bit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8"/>
                <RadioButton android:id="@+id/rb_16bit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:checked="true"/>
            </RadioGroup>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slope:"/>
            <EditText android:id="@+id/et_slope" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1.0" android:inputType="numberDecimal" android:textSize="13sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intercept:"/>
            <EditText android:id="@+id/et_intercept" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-1024.0" android:inputType="numberSigned|numberDecimal" android:textSize="13sp"/>
        </LinearLayout>

        <!-- 3) Operations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3) Preprocess Operations (Multiple Choice)"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <CheckBox android:id="@+id/cb_hu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HU校正 (ConvertRawToHU)"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_gaussian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高斯去噪"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" K:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_gauss_k" android:layout_width="40dp" android:layout_height="wrap_content" android:text="5" android:inputType="number" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_median" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="中值去噪"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" K:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_median_k" android:layout_width="40dp" android:layout_height="wrap_content" android:text="3" android:inputType="number" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_bilateral" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="双边去噪"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" d:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_bilateral_d" android:layout_width="40dp" android:layout_height="wrap_content" android:text="5" android:inputType="number" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_fft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="频域FFT"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" R:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_fft_r" android:layout_width="40dp" android:layout_height="wrap_content" android:text="30" android:inputType="number" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_resample" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重采样(尺寸)"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" W:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_res_w" android:layout_width="50dp" android:layout_height="wrap_content" android:text="512" android:inputType="number" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" H:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_res_h" android:layout_width="50dp" android:layout_height="wrap_content" android:text="512" android:inputType="number" android:textSize="12sp"/>
        </LinearLayout>

        <CheckBox android:id="@+id/cb_equalize" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="全局均衡化"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cb_clahe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CLAHE增强"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" clip:" android:textSize="12sp"/>
            <EditText android:id="@+id/et_clahe_clip" android:layout_width="40dp" android:layout_height="wrap_content" android:text="2.0" android:inputType="numberDecimal" android:textSize="12sp"/>
        </LinearLayout>

        <CheckBox android:id="@+id/cb_stretch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="对比度拉伸"/>

        <!-- 4) Execution -->
        <Button
            android:id="@+id/btn_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LOAD &amp; DISPLAY (Preprocess Chain)"/>

        <TextView
            android:id="@+id/tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="4dp"
            android:text="(status info)"/>

        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:background="#11000000"
            android:contentDescription="result image"/>

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:background="#EEE"
            android:textSize="12sp"
            android:text="Summary will appear after run."/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
