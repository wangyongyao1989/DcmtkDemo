<?xml version="1.0" encoding="utf-8"?><!--
    整个 fragment 用 NestedScrollView 包裹，所有内容（参数、按钮、信息、图像）都参与
    上下滑动。适用于"参数较多 + 图像较大（1500x1290 原图）"的场景，方便人工筛查
    时把页面滚到任意位置查看控件或图像细节。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Raw Pixel Deal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1) 最小链路验证：保留原有 verify 按钮 -->
        <Button
            android:id="@+id/btn_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) Run Verify Chain" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:text="Result will appear here..."
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <!-- 2) 原始像素缓冲区（assets 下 .bin）处理：人工筛查 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="2) Load assets .bin &amp; display via OpenCV"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Asset:" />

            <RadioGroup
                android:id="@+id/rg_asset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_data610"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Data610.bin" />

                <RadioButton
                    android:id="@+id/rb_data622"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data622.bin" />
            </RadioGroup>
        </LinearLayout>

        <!-- 宽 / 高 / 位深 一行参数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W:" />

            <EditText
                android:id="@+id/et_width"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="1112"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H:" />

            <EditText
                android:id="@+id/et_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="1740"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bit:" />

            <RadioGroup
                android:id="@+id/rg_bit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_8bit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8" />

                <RadioButton
                    android:id="@+id/rb_16bit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="16" />
            </RadioGroup>
        </LinearLayout>

        <!-- 四周裁剪像素数：用于去掉传感器空白边 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crop L:" />

            <EditText
                android:id="@+id/et_crop_l"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="80"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T:" />

            <EditText
                android:id="@+id/et_crop_t"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="140"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R:" />

            <EditText
                android:id="@+id/et_crop_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="80"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B:" />

            <EditText
                android:id="@+id/et_crop_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="500"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CLAHE 开关 + clip / tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_clahe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="CLAHE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="clip:" />

            <EditText
                android:id="@+id/et_clip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="2.0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="tile:" />

            <EditText
                android:id="@+id/et_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="8"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_load_asset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Load &amp; Display" />

        <TextView
            android:id="@+id/tv_asset_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:text="(image info)"
            android:textSize="11sp" />

        <!--
            图像展示：height=wrap_content，按 adjustViewBounds 等比缩放到
            layout_width 范围内；当图像很高（如原图 1500x1290 缩放到屏宽）
            时整体高度超过屏幕，可通过外层 NestedScrollView 滚动查看全图。
        -->
        <ImageView
            android:id="@+id/iv_raw_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="#11000000"
            android:contentDescription="raw pixel image"
            android:scaleType="fitStart" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="#33000000" />

        <!--
            3) CT 序列级处理管线（PRD ct-opencv-raw-buffer-windowing-prd）：
               raw buffer -> HU 标准化 -> OpenCV 优化 -> 自动裁剪 ->
               序列级自适应窗宽窗位 -> 8-bit 显示。
            UI 上只暴露少量常用参数；其它高级参数（形态学核、最小面积等）走默认。
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="3) CT Series Pipeline (HU + Auto-Crop + Adaptive Windowing)"
            android:textStyle="bold" />

        <!-- 序列选择（单张 = Data610.bin / Data622.bin） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Series (slices):" />

        <RadioGroup
            android:id="@+id/rg_series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_series_610"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="[610]" />

            <RadioButton
                android:id="@+id/rb_series_622"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[622]" />

            <RadioButton
                android:id="@+id/rb_series_610_622"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[610+622] (2 slices)" />
        </RadioGroup>

        <!--
            HU 转换 + 像素几何：
            width/height 复用上方 etWidth/etHeight；
            bitDepth 复用上方 8/16 单选。
            这里只新增 RescaleSlope/Intercept/bodyThreshold 三个核心 CT 参数。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slope:" />

            <EditText
                android:id="@+id/et_slope"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="1.0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Intercept:" />

            <EditText
                android:id="@+id/et_intercept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="-1024"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Body>:" />

            <EditText
                android:id="@+id/et_body_thr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberSigned"
                android:singleLine="true"
                android:text="-600"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
            v2 新增：像素符号位 + 百分位 Gmin/Gmax
            - Signed/Unsigned：裸 raw 误读为 signed 时切到 Unsigned（看 logcat RawPixelDealJni 提示）
            - pLow/pHigh：默认 0.5 / 99.5（百分位抗极端值）
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Pixel:" />

            <RadioGroup
                android:id="@+id/rg_pixel_sign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_pixel_signed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Signed" />

                <RadioButton
                    android:id="@+id/rb_pixel_unsigned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unsigned" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="pLow%:" />

            <EditText
                android:id="@+id/et_p_low"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="0.5"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="pHigh%:" />

            <EditText
                android:id="@+id/et_p_high"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="99.5"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
            调窗参数：N0 / N1 论文范围 [0.0005, 0.0025]；
            这里用 x1000 显示成整数便于输入。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N0(x1000):" />

            <EditText
                android:id="@+id/et_n0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="1.5"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="N1(x1000):" />

            <EditText
                android:id="@+id/et_n1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:text="1.5"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Stride:" />

            <EditText
                android:id="@+id/et_stride"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:singleLine="true"
                android:text="2"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_bilateral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Bilateral Filter (denoise in HU/16-bit domain)" />

        <CheckBox
            android:id="@+id/cb_display_clahe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Display CLAHE (boost soft-tissue contrast on 8-bit)" />

        <Button
            android:id="@+id/btn_run_series"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Run Series Pipeline" />

        <TextView
            android:id="@+id/tv_series_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="4dp"
            android:text="(series info)"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_series_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="#11000000"
            android:contentDescription="series pipeline result image"
            android:scaleType="fitStart" />

        <!-- ============================================================== -->
        <!--  X-ray 管线：ProcessPixelData-readme.md 5 步管线                -->
        <!--  raw → 16-bit → tailorImage → 直方图 → 调窗 → DICOM → 显示     -->
        <!-- ============================================================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="#33666666" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X-ray Pipeline (ProcessPixelData-readme 5-step)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- X-ray 数据源选择 -->
        <RadioGroup
            android:id="@+id/rg_xray_asset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_xray_610"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Data610.bin" />

            <RadioButton
                android:id="@+id/rb_xray_622"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data622.bin" />
        </RadioGroup>

        <!-- X-ray 调窗方法选择 -->
        <RadioGroup
            android:id="@+id/rg_xray_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_xray_method_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 默认固定窗 (127/255)"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_xray_method_minmax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="6. Min-Max (工程基线)"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_xray_method_cum72"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 72% 累计面积法"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_xray_method_bimodal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 双峰直方图法"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_xray_method_adaptive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. 自适应直方图法 (readme 5% / 95%)"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- X-ray 操作按钮 -->
        <Button
            android:id="@+id/btn_run_xray_pipeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="RUN X-RAY PIPELINE (Tailor + Window)" />

        <Button
            android:id="@+id/btn_write_dcm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:enabled="false"
            android:text="Write DICOM (.dcm) + Display" />

        <!-- X-ray 显示图像 -->
        <ImageView
            android:id="@+id/iv_xray_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:background="#11000000"
            android:contentDescription="xray pipeline result image"
            android:scaleType="fitStart" />

        <!-- X-ray 诊断信息 -->
        <TextView
            android:id="@+id/tv_xray_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="(X-ray pipeline not run yet)"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
